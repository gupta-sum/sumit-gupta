:root {
    --primary-color: #2563eb;
    --secondary-color: #1e293b;
    --background-color: #ffffff;
    --card-color: #f8fafc;
    --text-color: #222222;
    --border-radius: 12px;
    --shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
}

[data-theme="dark"] {
    --primary-color: #60a5fa;
    --secondary-color: #f1f5f9;
    --background-color: #0f172a;
    --card-color: #1e293b;
    --text-color: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: var(--background-color);
    color: var(--text-color);
    line-height: 1.6;
}

/* Header */

header {
    background-color: var(--primary-color);
    color: white;
    padding: 20px;
}

header h1 {
    text-align: center;
    margin-bottom: 15px;
}

/* Flexbox Navigation */

nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

nav a {
    text-decoration: none;
    color: white;
    text-align: center;
    display: block;
    padding: 10px;
    border-radius: 8px;
}

nav a:hover,
nav a:focus {
    background-color: rgba(255,255,255,0.2);
}

/* Main Layout Using CSS Grid */

main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px;
}

section,
article,
aside {
    background-color: var(--card-color);
    padding: 20px;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
}

section h2 {
    margin-bottom: 10px;
    color: var(--primary-color);
}

article {
    margin-top: 15px;
}

aside {
    border-left: 5px solid var(--primary-color);
}

/* Skills */

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.skills-list li {
    list-style: none;
    background-color: var(--primary-color);
    color: white;
    padding: 10px 15px;
    border-radius: 20px;
}

/* Projects Grid */

.projects-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
}

.project-card {
    transition: transform 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
}

/* Contact Form */

form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

label {
    font-weight: bold;
}

input,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #cccccc;
    border-radius: 8px;
}

button {
    background-color: var(--primary-color);
    color: white;
    border: none;
    padding: 12px;
    cursor: pointer;
    border-radius: 8px;
    transition: 0.3s;
}

button:hover {
    opacity: 0.9;
}

button:focus,
input:focus,
textarea:focus,
a:focus {
    outline: 3px solid #facc15;
}

/* Footer */

footer {
    text-align: center;
    padding: 20px;
    background-color: var(--secondary-color);
    color: white;
}

/* Tablet Layout */

@media (min-width: 768px) {

    nav ul {
        flex-direction: row;
        justify-content: center;
    }

    main {
        grid-template-columns: 2fr 1fr;
    }

    .projects-container {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* Desktop Layout */

@media (min-width: 1024px) {

    main {
        grid-template-columns: 3fr 1fr;
        max-width: 1200px;
        margin: auto;
    }

    .projects-container {
        grid-template-columns: repeat(3, 1fr);
    }

    header {
        padding: 30px;
    }

    body {
        font-size: 18px;
    }
}
