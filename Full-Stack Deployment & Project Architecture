<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>E-Commerce Product Catalog</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f4f4f4;
}

header{
background:#1e293b;
color:white;
padding:20px;
text-align:center;
}

nav{
margin-top:10px;
}

nav a{
color:white;
text-decoration:none;
margin:0 15px;
font-weight:bold;
}

.container{
width:90%;
max-width:1200px;
margin:auto;
padding:20px;
}

.hero{
text-align:center;
padding:40px;
background:white;
border-radius:10px;
margin-bottom:20px;
}

.products{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.card{
background:white;
padding:15px;
border-radius:10px;
box-shadow:0 2px 8px rgba(0,0,0,0.1);
}

.card img{
width:100%;
height:220px;
object-fit:cover;
border-radius:10px;
}

.card h3{
margin:10px 0;
}

.card p{
margin:8px 0;
}

button{
background:#2563eb;
color:white;
border:none;
padding:10px 15px;
border-radius:6px;
cursor:pointer;
}

button:hover{
background:#1d4ed8;
}

.details{
background:white;
padding:20px;
border-radius:10px;
}

.details img{
width:300px;
max-width:100%;
display:block;
margin-bottom:15px;
}

footer{
margin-top:30px;
background:#1e293b;
color:white;
text-align:center;
padding:15px;
}

</style>
</head>

<body>

<header>

<h1>E-Commerce Product Catalog</h1>

<nav>
<a href="#home">Home</a>
<a href="#products">Products</a>
</nav>

</header>

<div id="app" class="container"></div>

<footer>
Capstone Project - Full Stack Deployment & Project Architecture
</footer>

<script>

const products = [

{
id:1,
name:"Wireless Headphones",
price:2999,
category:"Electronics",
image:"https://picsum.photos/300?random=1",
description:"Premium quality wireless headphones."
},

{
id:2,
name:"Smart Watch",
price:4999,
category:"Electronics",
image:"https://picsum.photos/300?random=2",
description:"Advanced smartwatch with health tracking."
},

{
id:3,
name:"Running Shoes",
price:2499,
category:"Fashion",
image:"https://picsum.photos/300?random=3",
description:"Comfortable sports running shoes."
},

{
id:4,
name:"Backpack",
price:1499,
category:"Accessories",
image:"https://picsum.photos/300?random=4",
description:"Travel friendly backpack."
}

];

function homePage(){

return `
<div class="hero">
<h2>Welcome to Our Online Store</h2>
<p>Explore premium quality products.</p>
</div>
`;

}

function productsPage(){

let cards = "";

products.forEach(product=>{

cards += `
<div class="card">

<img src="${product.image}" loading="lazy">

<h3>${product.name}</h3>

<p>Category: ${product.category}</p>

<p>₹${product.price}</p>

<button onclick="viewProduct(${product.id})">
View Details
</button>

</div>
`;

});

return `
<h2 style="margin-bottom:20px;">
Product Catalog
</h2>

<div class="products">
${cards}
</div>
`;

}

function productDetails(id){

const product = products.find(item => item.id === id);

return `
<div class="details">

<img src="${product.image}">

<h2>${product.name}</h2>

<p><strong>Category:</strong>
${product.category}</p>

<p><strong>Price:</strong>
₹${product.price}</p>

<p>${product.description}</p>

<br>

<button onclick="location.hash='products'">
Back
</button>

</div>
`;

}

function router(){

const route = location.hash || "#home";

if(route === "#home"){
app.innerHTML = homePage();
}

else if(route === "#products"){
app.innerHTML = productsPage();
}

}

function viewProduct(id){

app.innerHTML = productDetails(id);

}

window.addEventListener("hashchange",router);

window.addEventListener("load",router);

</script>

</body>
</html>
